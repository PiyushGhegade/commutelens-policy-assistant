# Use a FREE-tier Google AI Studio project. Never commit your real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_PROVIDER=gemini
# Optional faster free-tier provider. Set LLM_PROVIDER=groq to select it.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Demo-only issuer. Disable before exposing the service beyond localhost.
DEMO_MODE=true
DEMO_PASSWORD=commute-demo
JWT_SECRET=local-case-study-change-this-secret-32-chars
DATA_DIR=data
EMBEDDING_MODEL=minilm
